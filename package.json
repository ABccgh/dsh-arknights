{
  "name": "@local/arknights",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Arknights assistant for DeepSeek Harness: fight/push/rogue, daily routines (award/credit store/recruitment/base), warehouse & operator-box snapshots, offline stage/material/drop-rate data and farming plans, driven by the local MAA core and the MuMu emulator",
  "license": "MIT",
  "exports": {
    ".": "./lib/index.js",
    "./preset": "./lib/preset/index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/sidecar/*.py",
    "client.js",
    "locale/*.json",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "docs/*.md",
    "skill/**"
  ],
  "meta": {
    "title": "明日方舟助手",
    "description": "用本机 MAA + MuMu 模拟器打《明日方舟》：总览、战斗、日常、资料、仓库、设置六页面板，覆盖打关卡/推关/肉鸽、日常任务、掉率与材料规划、干员盒与仓库快照。"
  },
  "scripts": {
    "test": "node --test \"test/*.test.js\" \"test/*.test.mjs\"",
    "test:unit": "node --test \"test/*.unit.test.js\"",
    "test:sidecar": "node --test test/sidecar.test.mjs",
    "selftest": "node test/run-selftest.mjs",
    "live": "node test/live-device.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
